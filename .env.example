ADMIN_SETUP_HASH=

# Server-only JSON of administrator email, name, id, salt and PBKDF2 password hash.
ADMIN_ACCOUNTS_JSON=

# Administrator authenticator encryption only (32+ random characters).
OTP_SECRET=
# Registration uses passwords directly; no email/SMS provider or domain required.
# Stripe-hosted Checkout. Leave disabled until test-mode and live acceptance tests pass.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_URL=
# Courier adapter name + HMAC webhook secret (32+ random characters)
COURIER_PROVIDER=
COURIER_WEBHOOK_SECRET=
# Production mock mode is refused regardless of these switches on the hosted origin.
APP_ENV=production
COURIER_MOCK_ENABLED=false
# Independent backup encryption key: 32 random bytes encoded as 64 hexadecimal characters.
BACKUP_ENCRYPTION_KEY=
BACKUP_JOB_SECRET=

# Project demo: no real payments, courier, maps or delivery details. Registration does not verify email ownership.
DEMO_MODE=true
